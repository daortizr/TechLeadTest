{
  "name": "flight-reservations",
  "version": "1.0.0",
  "description": "Real-time flight reservation system",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w @flight-reservations/shared && npm run build -w @flight-reservations/backend && npm run build -w @flight-reservations/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:reset": "docker-compose down -v && docker-compose up -d --build"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
