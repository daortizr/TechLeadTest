# Copy to .env (root, used by docker-compose) and/or backend/.env (used by `npm run dev`).
# Every value has a working default, so `docker-compose up --build` runs without any .env.

# --- Docker: database container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Host port for local development (`docker-compose up -d db`). Not 5432, to avoid a local PostgreSQL.
DB_HOST_PORT=5433

# --- Backend connection (docker-compose sets DB_HOST=db and the POSTGRES_* values itself) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false
# Schema used by the app; the integration tests use their own (flight_test)
DB_SCHEMA=public

# --- Backend ---
NODE_ENV=development
SERVER_PORT=3000
LOG_LEVEL=info
LOCK_TTL_SECONDS=300
CHECKOUT_TTL_SECONDS=300
PAYMENT_MARGIN_SECONDS=10
EXPIRATION_JOB_INTERVAL_MS=1000
HEARTBEAT_INTERVAL_MS=25000
PAYMENT_LATENCY_MS=0

# --- Admin: key for /api/admin/*, also injected into the frontend build as VITE_ADMIN_KEY ---
ADMIN_KEY=admin

# --- Frontend build ---
VITE_API_URL=/api
