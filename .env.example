# Database
POSTGRES_USER=flightuser
POSTGRES_PASSWORD=flightpass
POSTGRES_DB=flights_db
DATABASE_URL=postgres://flightuser:flightpass@db:5432/flights_db

# Backend
PORT=3000
NODE_ENV=development
LOCK_TTL_SECONDS=300
CHECKOUT_TTL_SECONDS=300
PAYMENT_MARGIN_SECONDS=10
EXPIRATION_JOB_INTERVAL_MS=1000
HEARTBEAT_INTERVAL_MS=25000
PAYMENT_LATENCY_MS=0

# Admin
ADMIN_KEY=admin-secret-key

# Frontend
VITE_API_URL=/api
VITE_ADMIN_KEY=admin-secret-key
